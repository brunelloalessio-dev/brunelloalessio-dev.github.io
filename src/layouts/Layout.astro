---
import "@/styles/global.css";
import SiteBackdrop from "@/components/SiteBackdrop.astro";
import type { Locale } from "@/i18n/utils";
import { getAlternateLocale, getLocalePath } from "@/i18n/utils";

interface Props {
  title: string;
  description: string;
  locale: Locale;
}

const { title, description, locale } = Astro.props;
const altLocale = getAlternateLocale(locale);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const altURL = new URL(getLocalePath(altLocale), Astro.site);
const ogImageURL = new URL("/og-image.jpg", Astro.site);
const ogImageAlt = "Alessio Brunello — Frontend Tech Lead";
---

<!doctype html>
<html lang={locale} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Dark mode: prevent flash + always start at top on reload -->
    <script is:inline>
      (function() {
        const saved = localStorage.getItem('theme');
        const theme = saved || 'dark';
        document.documentElement.classList.remove('dark', 'light');
        document.documentElement.classList.add(theme);

        if ('scrollRestoration' in history) {
          history.scrollRestoration = 'manual';
        }

        var goTop = function () {
          if (location.hash) return;
          window.scrollTo(0, 0);
        };

        goTop();
        window.addEventListener('DOMContentLoaded', goTop);
        window.addEventListener('load', goTop);
        window.addEventListener('pageshow', function (event) {
          if (event.persisted) goTop();
        });
      })();
    </script>

    <meta name="description" content={description} />
    <meta name="author" content="Alessio Brunello" />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical & Alternate -->
    <link rel="canonical" href={canonicalURL.href} />
    <link rel="alternate" hreflang={locale} href={canonicalURL.href} />
    <link rel="alternate" hreflang={altLocale} href={altURL.href} />
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(getLocalePath("it"), Astro.site).href}
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:locale" content={locale === "it" ? "it_IT" : "en_US"} />
    <meta property="og:site_name" content="Alessio Brunello — Portfolio" />
    <meta property="og:image" content={ogImageURL.href} />
    <meta property="og:image:secure_url" content={ogImageURL.href} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL.href} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body class="relative text-text-primary antialiased">
    <SiteBackdrop />
    <div class="relative z-10">
      <slot />
    </div>
  </body>
</html>
