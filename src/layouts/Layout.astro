---
import { ClientRouter, fade } from "astro:transitions";
import "@/styles/global.css";
import SiteBackdrop from "@/components/SiteBackdrop.astro";
import type { Locale } from "@/i18n/utils";
import { getAlternateLocale, withLocale } from "@/i18n/utils";

interface Props {
  title: string;
  description: string;
  locale: Locale;
}

const { title, description, locale } = Astro.props;
const altLocale = getAlternateLocale(locale);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const altURL = new URL(withLocale(Astro.url.pathname, altLocale), Astro.site);
const xDefaultURL = new URL(withLocale(Astro.url.pathname, "it"), Astro.site);
const ogImageURL = new URL("/og-image.jpg", Astro.site);
const ogImageAlt = "Alessio Brunello — Frontend Tech Lead";
---

<!doctype html>
<html lang={locale} class="dark" transition:animate={fade({ duration: "0.34s" })}>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />

    <!-- Browser chrome: tab / toolbar tint + native controls -->
    <meta name="color-scheme" content="dark light" />
    <meta
      name="theme-color"
      content="#09090b"
      media="(prefers-color-scheme: dark)"
    />
    <meta
      name="theme-color"
      content="#fafafa"
      media="(prefers-color-scheme: light)"
    />
    <meta name="theme-color" content="#09090b" />

    <!-- Dark mode: prevent flash + restore theme after view transitions -->
    <script is:inline>
      (function() {
        var THEME_COLORS = { dark: '#09090b', light: '#fafafa' };

        function applyBrowserChrome(theme) {
          document.documentElement.style.colorScheme = theme;
          var metas = document.querySelectorAll('meta[name="theme-color"]');
          for (var i = 0; i < metas.length; i++) {
            var media = metas[i].getAttribute('media');
            if (!media) {
              metas[i].setAttribute('content', THEME_COLORS[theme] || THEME_COLORS.dark);
            }
          }
        }

        function applyTheme(theme) {
          document.documentElement.classList.remove('dark', 'light');
          document.documentElement.classList.add(theme);
          applyBrowserChrome(theme);
        }

        var saved = localStorage.getItem('theme');
        var theme = saved || 'dark';
        applyTheme(theme);

        window.addEventListener('themechange', function (event) {
          var next = event && event.detail;
          if (next === 'dark' || next === 'light') applyBrowserChrome(next);
        });

        // ClientRouter swaps can reset <html class> from the fetched page
        document.addEventListener('astro:after-swap', function () {
          var next = localStorage.getItem('theme') || 'dark';
          applyTheme(next);
        });

        if ('scrollRestoration' in history) {
          history.scrollRestoration = 'manual';
        }

        var goTop = function () {
          if (location.hash) return;
          window.scrollTo(0, 0);
        };

        goTop();
        window.addEventListener('DOMContentLoaded', goTop);
        window.addEventListener('load', goTop);
        window.addEventListener('pageshow', function (event) {
          if (event.persisted) goTop();
        });
      })();
    </script>

    <meta name="description" content={description} />
    <meta name="author" content="Alessio Brunello" />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical & Alternate -->
    <link rel="canonical" href={canonicalURL.href} />
    <link rel="alternate" hreflang={locale} href={canonicalURL.href} />
    <link rel="alternate" hreflang={altLocale} href={altURL.href} />
    <link
      rel="alternate"
      hreflang="x-default"
      href={xDefaultURL.href}
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:locale" content={locale === "it" ? "it_IT" : "en_US"} />
    <meta property="og:site_name" content="Alessio Brunello — Portfolio" />
    <meta property="og:image" content={ogImageURL.href} />
    <meta property="og:image:secure_url" content={ogImageURL.href} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL.href} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Favicon / Safari bookmarks & pinned tabs -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#09090b" />

    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="relative text-text-primary antialiased">
    <SiteBackdrop />
    <!-- Safari 26+ toolbar tint probes (ignored by older Safari; theme-color still helps there) -->
    <div class="safari-toolbar-tint safari-toolbar-tint--top" aria-hidden="true"></div>
    <div class="safari-toolbar-tint safari-toolbar-tint--bottom" aria-hidden="true"></div>
    <div class="relative z-10">
      <slot />
    </div>
    <script>
      import { bootSiteBackdrop } from "@/scripts/site-backdrop";
      bootSiteBackdrop();
    </script>
  </body>
</html>
