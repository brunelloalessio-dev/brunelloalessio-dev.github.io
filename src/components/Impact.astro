---
import type { Locale } from "@/i18n/utils";
import { t } from "@/i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i18n = t(locale);
const impact = i18n.impact;
const steps = [impact.case.problem, impact.case.approach, impact.case.result];
---

<section id="impact" class="relative py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="fade-in mb-16 text-center">
      <h2 class="text-gradient mb-4 text-3xl font-bold sm:text-4xl">{impact.title}</h2>
      <p class="mx-auto max-w-2xl text-text-secondary">{impact.subtitle}</p>
      <div class="mx-auto mt-4 h-1 w-20 rounded-full bg-accent-soft"></div>
    </div>

    <article class="fade-in glass card-surface mx-auto max-w-4xl rounded-2xl p-6 sm:p-10">
      <div class="mb-8">
        <span class="mb-3 inline-block rounded-lg bg-accent/10 px-3 py-1 text-xs font-bold uppercase tracking-wider text-accent">
          {impact.eyebrow}
        </span>
        <h3 class="text-2xl font-bold text-text-primary sm:text-3xl">{impact.case.title}</h3>
        <p class="mt-2 text-sm text-text-secondary">{impact.case.context}</p>
      </div>

      <div class="mb-8 flex flex-wrap items-end gap-x-5 gap-y-2 border-b border-[color:var(--color-glass-border)] pb-8">
        <p class="text-6xl font-extrabold leading-none tracking-tight text-accent sm:text-7xl">
          {impact.stat.value}
        </p>
        <p class="max-w-[16rem] pb-1 text-sm leading-snug text-text-secondary sm:text-base">
          {impact.stat.label}
        </p>
      </div>

      <div class="stagger-grid grid gap-6">
        {
          steps.map((step) => (
            <div class="stagger-item rounded-xl border border-[color:var(--color-glass-border)] bg-[color:var(--color-glass-bg)] p-5 sm:p-6">
              <h4 class="mb-2 text-xs font-bold uppercase tracking-[0.16em] text-accent-soft">
                {step.label}
              </h4>
              <p class="text-sm leading-relaxed text-text-secondary sm:text-base">{step.text}</p>
            </div>
          ))
        }
      </div>
    </article>
  </div>
</section>
