---
import type { Locale } from "@/i18n/utils";
import { t } from "@/i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i18n = t(locale);

const icons: Record<string, string> = {
  React: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/react/react-original.svg",
  TypeScript: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/typescript/typescript-original.svg",
  "Tailwind CSS": "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/tailwindcss/tailwindcss-original.svg",
  "React Native": "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/react/react-original.svg",
  Flutter: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/flutter/flutter-original.svg",
  AngularJS: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/angularjs/angularjs-original.svg",
  "Vue.js": "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/vuejs/vuejs-original.svg",
};
---

<section id="skills" class="relative py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="fade-in mb-16 text-center">
      <h2 class="text-gradient mb-4 text-3xl font-bold sm:text-4xl">
        {i18n.skills.title}
      </h2>
      <p class="text-text-secondary">{i18n.skills.subtitle}</p>
      <div class="mx-auto mt-4 h-1 w-20 rounded-full bg-accent-soft"></div>
    </div>

    <div class="mx-auto flex max-w-4xl flex-col gap-10">
      {
        i18n.skills.groups.map((group, index) => (
          <div class:list={["fade-in", index === 1 && "opacity-80"]}>
            <h3 class="mb-4 text-xs font-bold uppercase tracking-[0.16em] text-accent-soft">
              {group.label}
            </h3>
            <div class="flex flex-wrap gap-3">
              {group.items.map((name) => (
                <div class="skill-chip glass flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-text-secondary">
                  {icons[name] ? (
                    <img src={icons[name]} alt="" class="h-5 w-5" loading="lazy" />
                  ) : (
                    <span class="flex h-5 w-5 items-center justify-center rounded bg-accent/10 text-[10px] font-bold text-accent">
                      {name.charAt(0)}
                    </span>
                  )}
                  <span>{name}</span>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
