---
import type { Locale } from "@/i18n/utils";
import { t } from "@/i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i18n = t(locale);
const items = i18n.beyond.items;
---

<section id="beyond" class="relative py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="fade-in mb-16 text-center">
      <h2 class="text-gradient mb-4 text-3xl font-bold sm:text-4xl">
        {i18n.beyond.title}
      </h2>
      <p class="mx-auto max-w-2xl text-text-secondary">{i18n.beyond.subtitle}</p>
      <div class="mx-auto mt-4 h-1 w-20 rounded-full bg-accent-soft"></div>
    </div>

    <div class="fade-in mx-auto mb-10 max-w-3xl text-center">
      <p class="text-base leading-relaxed text-text-secondary sm:text-lg">
        {i18n.beyond.intro}
      </p>
    </div>

    <div class="stagger-grid mx-auto grid max-w-5xl gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        items.map((item) => (
          <article class="stagger-item glass hover-glow rounded-2xl p-6 sm:p-7">
            <h3 class="mb-3 text-lg font-bold text-text-primary">{item.title}</h3>
            <p class="text-sm leading-relaxed text-text-secondary sm:text-base">
              {item.description}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
