---
---

<div
  class="site-backdrop pointer-events-none fixed inset-0 z-0 overflow-hidden"
  aria-hidden="true"
>
  <div
    class="site-orb site-orb--cyan absolute -left-20 top-[-4%] h-[20rem] w-[20rem] md:h-[28rem] md:w-[28rem]"
    data-orb
    data-strength="26"
    data-amp="14"
    data-speed="0.32"
  >
    <span class="site-orb__glow"></span>
    <span class="site-orb__core"></span>
  </div>
  <div
    class="site-orb site-orb--magenta absolute -right-16 top-[24%] h-[17rem] w-[17rem] md:h-[24rem] md:w-[24rem]"
    data-orb
    data-strength="30"
    data-amp="16"
    data-speed="0.26"
    data-invert="true"
  >
    <span class="site-orb__glow"></span>
    <span class="site-orb__core"></span>
  </div>
  <div
    class="site-orb site-orb--blue absolute right-[14%] top-[56%] h-60 w-60 md:h-72 md:w-72"
    data-orb
    data-strength="28"
    data-amp="12"
    data-speed="0.4"
    data-invert="true"
  >
    <span class="site-orb__glow"></span>
    <span class="site-orb__core"></span>
  </div>
  <div
    class="site-orb site-orb--amber absolute left-[10%] bottom-[-10%] h-[18rem] w-[18rem] md:h-[24rem] md:w-[24rem]"
    data-orb
    data-strength="22"
    data-amp="13"
    data-speed="0.36"
  >
    <span class="site-orb__glow"></span>
    <span class="site-orb__core"></span>
  </div>

  <div class="site-grid absolute inset-0" data-site-grid></div>
  <div class="absolute inset-0 bg-gradient-to-b from-bg-primary/28 via-transparent to-bg-primary/38"></div>
</div>
