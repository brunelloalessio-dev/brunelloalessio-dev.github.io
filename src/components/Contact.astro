---
import type { Locale } from "@/i18n/utils";
import { t } from "@/i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i18n = t(locale);
const shareUrl = new URL(`/${locale}/`, Astro.site).href;
---

<section id="contact" class="relative py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div class="fade-in mb-16 text-center">
      <h2 class="text-gradient mb-4 text-3xl font-bold sm:text-4xl">{i18n.contact.title}</h2>
      <p class="text-text-secondary">{i18n.contact.subtitle}</p>
      <div class="mx-auto mt-4 h-1 w-20 rounded-full bg-accent-soft"></div>
    </div>

    <!-- Contact cards -->
    <div class="stagger-grid mx-auto grid max-w-5xl gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <!-- Email -->
      <button
        id="copy-email"
        type="button"
        class="stagger-item glass card-action group flex min-h-[11rem] flex-col items-center rounded-2xl p-8 text-center"
        data-email={i18n.contact.email.value}
      >
        <div class="mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-accent/10 transition-colors group-hover:bg-accent/20">
          <svg class="h-8 w-8 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/>
          </svg>
        </div>
        <h3 class="mb-1 text-lg font-semibold text-text-primary">{i18n.contact.email.label}</h3>
        <p class="mb-3 break-all text-sm text-text-secondary">{i18n.contact.email.value}</p>
        <span
          id="copy-email-text"
          class="text-xs font-medium text-accent"
          data-copied={i18n.contact.email.copied}
        >{i18n.contact.email.cta}</span>
      </button>

      <!-- CV -->
      <a
        href={i18n.contact.cv.url}
        class="stagger-item glass card-action group flex min-h-[11rem] flex-col items-center rounded-2xl p-8 text-center"
      >
        <div class="mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-accent/10 transition-colors group-hover:bg-accent/20">
          <svg class="h-8 w-8 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/>
          </svg>
        </div>
        <h3 class="mb-1 text-lg font-semibold text-text-primary">{i18n.contact.cv.label}</h3>
        <p class="mb-3 text-sm text-text-secondary">{i18n.contact.cv.value}</p>
        <span class="text-xs font-medium text-accent">{i18n.contact.cv.cta} →</span>
      </a>

      <!-- LinkedIn -->
      <a
        href={i18n.contact.linkedin.url}
        target="_blank"
        rel="noopener noreferrer"
        class="stagger-item glass card-action group flex min-h-[11rem] flex-col items-center rounded-2xl p-8 text-center"
      >
        <div class="mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-accent/10 transition-colors group-hover:bg-accent/20">
          <svg class="h-8 w-8 text-accent" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </div>
        <h3 class="mb-1 text-lg font-semibold text-text-primary">{i18n.contact.linkedin.label}</h3>
        <p class="mb-3 text-sm text-text-secondary">{i18n.contact.linkedin.value}</p>
        <span class="text-xs font-medium text-accent">{i18n.contact.linkedin.cta} →</span>
      </a>

      <!-- GitHub -->
      <a
        href={i18n.contact.github.url}
        target="_blank"
        rel="noopener noreferrer"
        class="stagger-item glass card-action group flex min-h-[11rem] flex-col items-center rounded-2xl p-8 text-center"
      >
        <div class="mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-accent/10 transition-colors group-hover:bg-accent/20">
          <svg class="h-8 w-8 text-accent" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
          </svg>
        </div>
        <h3 class="mb-1 text-lg font-semibold text-text-primary">{i18n.contact.github.label}</h3>
        <p class="mb-3 text-sm text-text-secondary">{i18n.contact.github.value}</p>
        <span class="text-xs font-medium text-accent">{i18n.contact.github.cta} →</span>
      </a>

      <!-- Share: Web Share API on Safari/iOS/Android, clipboard fallback elsewhere -->
      <button
        id="share-site"
        type="button"
        class="stagger-item glass card-action group flex min-h-[11rem] flex-col items-center rounded-2xl p-8 text-center sm:col-span-2 lg:col-span-1"
        data-share-title={i18n.contact.share.title}
        data-share-text={i18n.contact.share.text}
        data-share-url={shareUrl}
      >
        <div class="mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-accent/10 transition-colors group-hover:bg-accent/20">
          <svg class="h-8 w-8 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 100 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186l9.566-5.314m-9.566 7.5l9.566 5.314m0 0a2.25 2.25 0 103.935 2.186 2.25 2.25 0 00-3.935-2.186zm0-12.814a2.25 2.25 0 103.933-2.185 2.25 2.25 0 00-3.933 2.185z"/>
          </svg>
        </div>
        <h3 class="mb-1 text-lg font-semibold text-text-primary">{i18n.contact.share.label}</h3>
        <p class="mb-3 text-sm text-text-secondary">{i18n.contact.share.value}</p>
        <span
          id="share-site-text"
          class="text-xs font-medium text-accent"
          data-copied={i18n.contact.share.copied}
        >{i18n.contact.share.cta}</span>
      </button>
    </div>
  </div>
</section>

<div id="action-burst" class="action-burst" aria-hidden="true">
  <div class="action-burst__ring" data-burst-ring></div>
  <div class="action-burst__ring action-burst__ring--late" data-burst-ring-late></div>
  <div class="action-burst__sparks" data-burst-sparks></div>
</div>

<style>
  :global(.action-burst) {
    position: fixed;
    inset: 0;
    z-index: 9995;
    pointer-events: none;
    display: none;
    overflow: hidden;
  }

  :global(.action-burst.is-active) {
    display: block;
  }

  :global(.action-burst__ring) {
    position: absolute;
    left: var(--ab-x, 50%);
    top: var(--ab-y, 50%);
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 2px solid rgba(52, 211, 153, 0.75);
    box-shadow: 0 0 18px rgba(52, 211, 153, 0.35);
    transform: translate(-50%, -50%) scale(0.3);
    opacity: 0;
  }

  :global(.action-burst__ring--late) {
    border-color: rgba(56, 189, 248, 0.7);
    box-shadow: 0 0 18px rgba(56, 189, 248, 0.3);
  }

  :global(.action-burst__sparks) {
    position: absolute;
    inset: 0;
  }

  :global(.action-spark) {
    position: absolute;
    left: var(--ab-x, 50%);
    top: var(--ab-y, 50%);
    font-size: 0.85rem;
    font-weight: 700;
    color: rgba(52, 211, 153, 0.95);
    text-shadow: 0 0 12px rgba(52, 211, 153, 0.55);
    opacity: 0;
    will-change: transform, opacity;
    user-select: none;
  }

  :global(.card-action.is-success) {
    border-color: rgba(52, 211, 153, 0.45) !important;
    box-shadow:
      0 10px 28px rgba(0, 0, 0, 0.28),
      0 0 0 1px rgba(52, 211, 153, 0.18),
      0 0 28px rgba(52, 211, 153, 0.22) !important;
    transition:
      box-shadow 0.35s ease,
      border-color 0.35s ease;
  }

  :global(html.light .card-action.is-success) {
    box-shadow:
      0 12px 28px rgba(0, 0, 0, 0.08),
      0 0 0 1px rgba(16, 185, 129, 0.2),
      0 0 22px rgba(16, 185, 129, 0.16) !important;
  }
</style>

<script>
  import { bootContact } from "@/scripts/contact";
  bootContact();
</script>
