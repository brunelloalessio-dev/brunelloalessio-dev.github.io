---
import type { Locale } from "@/i18n/utils";
import { t } from "@/i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const page = t(locale).privacy;
const email = t(locale).contact.email.value;

type Chunk = { type: "text" | "email" | "url"; value: string };

function chunks(text: string): Chunk[] {
  const out: Chunk[] = [];
  const re = /\{email\}|(https?:\/\/[^\s]+)/g;
  let last = 0;

  for (const match of text.matchAll(re)) {
    const index = match.index ?? 0;
    if (index > last) out.push({ type: "text", value: text.slice(last, index) });

    const token = match[0];
    if (token === "{email}") {
      out.push({ type: "email", value: email });
    } else {
      const value = token.replace(/[.,;:]+$/, "");
      out.push({ type: "url", value });
      const trail = token.slice(value.length);
      if (trail) out.push({ type: "text", value: trail });
    }

    last = index + token.length;
  }

  if (last < text.length) out.push({ type: "text", value: text.slice(last) });
  return out;
}
---

<article class="mx-auto max-w-3xl px-4 pb-24 pt-32 sm:px-6">
  <h1 class="text-gradient text-3xl font-bold sm:text-4xl">{page.title}</h1>
  <p class="mt-3 text-sm text-text-secondary">{page.updated}</p>

  <div class="mt-12 space-y-10">
    {
      page.sections.map((section) => (
        <section>
          <h2 class="mb-3 text-lg font-semibold text-text-primary">{section.heading}</h2>
          <div class="space-y-3 text-sm leading-relaxed text-text-secondary sm:text-base">
            {section.paragraphs.map((paragraph) => (
              <p>
                {chunks(paragraph).map((part) =>
                  part.type === "email" ? (
                    <a href={`mailto:${part.value}`} class="text-text-primary underline underline-offset-4 hover:text-accent">
                      {part.value}
                    </a>
                  ) : part.type === "url" ? (
                    <a
                      href={part.value}
                      class="text-text-primary underline underline-offset-4 hover:text-accent"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {part.value.replace(/^https?:\/\//, "")}
                    </a>
                  ) : (
                    part.value
                  ),
                )}
              </p>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</article>
