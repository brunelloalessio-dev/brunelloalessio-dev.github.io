---
import type { Locale } from "@/i18n/utils";
import { t } from "@/i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const elevator = t(locale).elevator;
const label = elevator.label;
const tooltip = elevator.tooltip;
---

<button
  id="back-to-top"
  type="button"
  class="elevator"
  aria-label={label}
  aria-describedby="elevator-tooltip"
  aria-hidden="true"
  hidden
>
  <svg class="elevator__ring" viewBox="0 0 56 56" aria-hidden="true">
    <circle class="elevator__track" cx="28" cy="28" r="24" />
    <circle
      class="elevator__progress"
      cx="28"
      cy="28"
      r="24"
      pathLength="100"
    />
  </svg>
  <span class="elevator__core glass hover-glow">
    <svg class="elevator__arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.75"
        d="M12 19V5m0 0l-6 6m6-6l6 6"
      />
    </svg>
  </span>
  <span id="elevator-tooltip" class="elevator__tooltip" role="tooltip">
    {tooltip}
  </span>
</button>

<div id="hyperspace" class="hyperspace" aria-hidden="true">
  <canvas class="hyperspace__canvas" data-hyperspace-canvas></canvas>
  <div class="hyperspace__vignette"></div>
  <div class="hyperspace__flash" data-hyperspace-flash></div>
</div>

<style>
  .elevator {
    --elevator-size: 3.25rem;
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1.25rem, env(safe-area-inset-bottom));
    z-index: 40;
    width: var(--elevator-size);
    height: var(--elevator-size);
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    color: var(--color-text-primary);
    opacity: 0;
    transform: translateY(12px) scale(0.92);
    pointer-events: none;
    transition:
      opacity 0.35s ease,
      transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .elevator.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  .elevator.is-visible.is-launching .elevator__core,
  .elevator.is-launching .elevator__core {
    transform: translateY(-3px) scale(0.94);
    animation: none;
    box-shadow: none;
  }

  .elevator.is-visible.is-launching:hover .elevator__arrow,
  .elevator.is-visible.is-launching:focus-visible .elevator__arrow,
  .elevator.is-launching .elevator__arrow {
    animation: elevator-arrow-lift 0.55s cubic-bezier(0.22, 1, 0.36, 1);
    color: inherit;
  }

  .elevator.is-visible.is-launching:hover::before,
  .elevator.is-visible.is-launching:focus-visible::before,
  .elevator.is-launching::before {
    opacity: 0;
    transform: scale(0.7);
  }

  .elevator::before {
    content: "";
    position: absolute;
    inset: -10px;
    border-radius: 9999px;
    background:
      radial-gradient(circle, rgba(125, 211, 252, 0.28) 0%, rgba(255, 255, 255, 0.08) 38%, transparent 70%);
    opacity: 0;
    transform: scale(0.72);
    filter: blur(2px);
    transition:
      opacity 0.35s ease,
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
    z-index: -1;
  }

  :global(html.light) .elevator::before {
    background:
      radial-gradient(circle, rgba(14, 165, 233, 0.22) 0%, rgba(9, 9, 11, 0.08) 40%, transparent 72%);
  }

  .elevator__ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
    transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1), filter 0.35s ease;
  }

  .elevator__track,
  .elevator__progress {
    fill: none;
    stroke-width: 1.5;
    transition: stroke 0.3s ease, opacity 0.3s ease, stroke-width 0.3s ease;
  }

  .elevator__track {
    stroke: var(--color-glass-border);
  }

  .elevator__progress {
    stroke: var(--color-accent);
    stroke-linecap: round;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    transition:
      stroke-dashoffset 0.12s linear,
      stroke 0.3s ease,
      opacity 0.3s ease,
      stroke-width 0.3s ease,
      filter 0.35s ease;
    opacity: 0.85;
  }

  .elevator__core {
    position: absolute;
    inset: 6px;
    display: grid;
    place-items: center;
    border-radius: 9999px;
    transition:
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.35s ease,
      border-color 0.3s ease,
      background 0.3s ease;
  }

  .elevator.is-visible:hover::before,
  .elevator.is-visible:focus-visible::before {
    opacity: 1;
    transform: scale(1);
  }

  .elevator.is-visible:hover .elevator__ring,
  .elevator.is-visible:focus-visible .elevator__ring {
    transform: rotate(-90deg) scale(1.06);
    filter: drop-shadow(0 0 6px rgba(125, 211, 252, 0.45));
  }

  .elevator.is-visible:hover .elevator__track,
  .elevator.is-visible:focus-visible .elevator__track {
    stroke: color-mix(in oklab, var(--color-accent) 35%, var(--color-glass-border));
    opacity: 0.95;
  }

  .elevator.is-visible:hover .elevator__progress,
  .elevator.is-visible:focus-visible .elevator__progress {
    stroke: #7dd3fc;
    stroke-width: 2;
    opacity: 1;
    filter: drop-shadow(0 0 4px rgba(125, 211, 252, 0.75));
  }

  :global(html.light) .elevator.is-visible:hover .elevator__progress,
  :global(html.light) .elevator.is-visible:focus-visible .elevator__progress {
    stroke: #0284c7;
    filter: drop-shadow(0 0 3px rgba(2, 132, 199, 0.45));
  }

  .elevator.is-visible:hover .elevator__core,
  .elevator.is-visible:focus-visible .elevator__core {
    transform: translateY(-3px) scale(1.06);
    border-color: color-mix(in oklab, #7dd3fc 45%, var(--color-glass-border));
    box-shadow:
      0 0 0 1px color-mix(in oklab, #7dd3fc 25%, transparent),
      0 8px 24px rgba(0, 0, 0, 0.28),
      0 0 28px rgba(125, 211, 252, 0.22);
  }

  :global(html.light) .elevator.is-visible:hover .elevator__core,
  :global(html.light) .elevator.is-visible:focus-visible .elevator__core {
    border-color: color-mix(in oklab, #0284c7 40%, var(--color-glass-border));
    box-shadow:
      0 0 0 1px color-mix(in oklab, #0284c7 18%, transparent),
      0 10px 22px rgba(0, 0, 0, 0.1),
      0 0 22px rgba(2, 132, 199, 0.16);
  }

  .elevator.is-visible:hover .elevator__arrow,
  .elevator.is-visible:focus-visible .elevator__arrow {
    animation: elevator-arrow-hover 0.9s cubic-bezier(0.22, 1, 0.36, 1) infinite;
    color: #7dd3fc;
  }

  :global(html.light) .elevator.is-visible:hover .elevator__arrow,
  :global(html.light) .elevator.is-visible:focus-visible .elevator__arrow {
    color: #0284c7;
  }

  .elevator:focus-visible {
    outline: none;
  }

  .elevator:focus-visible .elevator__core {
    box-shadow:
      0 0 0 2px var(--color-bg-primary),
      0 0 0 4px var(--color-accent-soft),
      0 0 24px rgba(125, 211, 252, 0.2);
  }

  .elevator__arrow {
    width: 1.15rem;
    height: 1.15rem;
    display: block;
    transition: color 0.25s ease;
  }

  .elevator__tooltip {
    position: absolute;
    right: calc(100% + 0.75rem);
    top: 50%;
    z-index: 1;
    max-width: 14rem;
    padding: 0.45rem 0.7rem;
    border-radius: 0.7rem;
    border: 1px solid var(--color-glass-border);
    background: color-mix(in oklab, var(--color-bg-secondary) 88%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.28);
    color: var(--color-text-primary);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1.3;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transform: translate(6px, -50%);
    transition:
      opacity 0.22s ease,
      transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .elevator__tooltip::after {
    content: "";
    position: absolute;
    right: -5px;
    top: 50%;
    width: 8px;
    height: 8px;
    border-right: 1px solid var(--color-glass-border);
    border-bottom: 1px solid var(--color-glass-border);
    background: color-mix(in oklab, var(--color-bg-secondary) 88%, transparent);
    transform: translateY(-50%) rotate(-45deg);
  }

  .elevator.is-visible:hover .elevator__tooltip,
  .elevator.is-visible:focus-visible .elevator__tooltip {
    opacity: 1;
    transform: translate(0, -50%);
  }

  .elevator.is-launching .elevator__tooltip {
    opacity: 0;
    transform: translate(6px, -50%);
  }

  .hyperspace {
    position: fixed;
    inset: 0;
    z-index: 60;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
  }

  .hyperspace.is-active {
    visibility: visible;
  }

  .hyperspace__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .hyperspace__vignette {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 55% at 50% 12%, rgba(125, 211, 252, 0.08), transparent 55%),
      radial-gradient(ellipse at center, transparent 8%, rgba(0, 0, 0, 0.78) 100%);
    opacity: 1;
  }

  :global(html.light) .hyperspace__vignette {
    background:
      radial-gradient(ellipse 70% 55% at 50% 12%, rgba(56, 189, 248, 0.1), transparent 55%),
      radial-gradient(ellipse at center, transparent 5%, rgba(2, 4, 12, 0.72) 100%);
  }

  .hyperspace__flash {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse at 50% 18%,
      rgba(255, 255, 255, 0.95) 0%,
      rgba(125, 211, 252, 0.55) 24%,
      rgba(56, 189, 248, 0.12) 50%,
      transparent 70%
    );
    opacity: 0;
  }

  @keyframes elevator-arrow-lift {
    0% {
      transform: translateY(0);
      opacity: 1;
    }
    45% {
      transform: translateY(-10px);
      opacity: 0;
    }
    46% {
      transform: translateY(8px);
      opacity: 0;
    }
    100% {
      transform: translateY(0);
      opacity: 1;
    }
  }

  @keyframes elevator-arrow-hover {
    0%,
    100% {
      transform: translateY(1px);
    }
    50% {
      transform: translateY(-3px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .elevator,
    .elevator__core,
    .elevator__progress,
    .elevator__tooltip,
    .elevator__ring,
    .elevator::before {
      transition: none;
    }

    .elevator.is-launching .elevator__arrow,
    .elevator.is-visible:hover .elevator__arrow,
    .elevator.is-visible:focus-visible .elevator__arrow {
      animation: none;
    }

    .hyperspace {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .elevator__tooltip {
      display: none;
    }
  }
</style>
