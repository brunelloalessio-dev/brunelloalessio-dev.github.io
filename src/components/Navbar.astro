---
import type { Locale } from "@/i18n/utils";
import { t, getAlternateLocale, getLocalePath } from "@/i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i18n = t(locale);
const altLocale = getAlternateLocale(locale);
const altPath = getLocalePath(altLocale);
---

<nav
  id="navbar"
  class="site-header fixed top-0 left-0 right-0 z-50 pt-[env(safe-area-inset-top)] transition-[border-color,box-shadow,background-color] duration-300"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between md:h-20">
      <!-- Logo -->
      <a
        href={`/${locale}/`}
        class="nav-logo text-gradient text-xl font-extrabold tracking-tight md:text-2xl"
        transition:name="brand-logo"
      >
        AB
      </a>

      <!-- Desktop Nav Links -->
      <div class="hidden items-center gap-5 lg:gap-7 md:flex">
        <a href="#about" class="nav-link">{i18n.nav.about}</a>
        <a href="#skills" class="nav-link">{i18n.nav.skills}</a>
        <a href="#experience" class="nav-link">{i18n.nav.experience}</a>
        <a href="#teaching" class="nav-link">{i18n.nav.teaching}</a>
        <a href="#certifications" class="nav-link">{i18n.nav.certifications}</a>
        <a href="#beyond" class="nav-link">{i18n.nav.beyond}</a>
        <a href="#contact" class="nav-link">{i18n.nav.contact}</a>
      </div>

      <!-- Right side: Theme toggle + Lang switch + GitHub + Mobile menu -->
      <div class="flex items-center gap-3">
        <!-- Theme Toggle -->
        <button
          id="theme-toggle"
          class="nav-icon inline-flex"
          aria-label="Toggle theme"
        >
          <!-- Sun icon (shown in dark mode) -->
          <svg id="icon-sun" class="hidden h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z"/>
          </svg>
          <!-- Moon icon (shown in light mode) -->
          <svg id="icon-moon" class="hidden h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z"/>
          </svg>
        </button>

        <!-- Language Switch -->
        <a
          href={altPath}
          class="nav-lang glass rounded-lg px-3 py-1.5 text-xs font-semibold uppercase tracking-wider"
        >
          {altLocale.toUpperCase()}
        </a>

        <!-- GitHub -->
        <a
          href="https://github.com/brunelloalessio-dev"
          target="_blank"
          rel="noopener noreferrer"
          class="nav-icon inline-flex"
          aria-label="GitHub"
        >
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
          </svg>
        </a>

        <!-- Mobile Menu Button -->
        <button
          id="mobile-menu-btn"
          type="button"
          class="nav-icon relative z-[60] inline-flex md:hidden"
          aria-label="Menu"
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu: pointer-events-none when closed so it cannot steal burger taps -->
  <div
    id="mobile-menu"
    class="mobile-drawer glass-strong md:hidden"
  >
    <div class="flex flex-col gap-6 p-8">
      <a href="#about" class="mobile-nav-link">{i18n.nav.about}</a>
      <a href="#skills" class="mobile-nav-link">{i18n.nav.skills}</a>
      <a href="#experience" class="mobile-nav-link">{i18n.nav.experience}</a>
      <a href="#teaching" class="mobile-nav-link">{i18n.nav.teaching}</a>
      <a href="#certifications" class="mobile-nav-link">{i18n.nav.certifications}</a>
      <a href="#beyond" class="mobile-nav-link">{i18n.nav.beyond}</a>
      <a href="#contact" class="mobile-nav-link">{i18n.nav.contact}</a>
    </div>
  </div>
</nav>

<style>
  /*
    Solid header band into the iOS status-bar safe area.
    No backdrop-filter on the root: Safari 26 samples this color for the
    system status bar (time / battery), so chrome + header read as one strip.
  */
  .site-header {
    background-color: var(--color-bg-primary);
    border-bottom: 1px solid transparent;
  }

  .site-header.is-scrolled {
    border-bottom-color: var(--color-glass-border);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.22);
  }

  :global(html.light) .site-header.is-scrolled {
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.06);
  }

  .mobile-drawer {
    position: fixed;
    top: calc(4rem + env(safe-area-inset-top));
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 55;
    opacity: 0;
    transform: translate3d(-100%, 0, 0);
    pointer-events: none;
    visibility: hidden;
    transition:
      transform 0.3s ease,
      opacity 0.3s ease,
      visibility 0.3s ease;
  }

  .mobile-drawer.nav-open {
    opacity: 1;
    transform: translate3d(0, 0, 0);
    pointer-events: auto;
    visibility: visible;
  }

  :global(body.nav-menu-open) {
    overflow: hidden;
  }

  .nav-link,
  .mobile-nav-link {
    position: relative;
    display: inline-block;
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      color 0.28s ease,
      text-shadow 0.35s ease,
      transform 0.28s ease;
  }

  .mobile-nav-link {
    font-size: 1.125rem;
    width: fit-content;
  }

  .nav-link::after,
  .mobile-nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -0.35rem;
    width: 100%;
    height: 2px;
    border-radius: 999px;
    background: linear-gradient(
      90deg,
      rgba(56, 189, 248, 0.95),
      rgba(217, 70, 239, 0.9),
      rgba(96, 165, 250, 0.95)
    );
    transform: scaleX(0);
    transform-origin: left center;
    transition:
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.35s ease,
      opacity 0.35s ease;
    opacity: 0.85;
    box-shadow:
      0 0 8px rgba(56, 189, 248, 0.55),
      0 0 18px rgba(217, 70, 239, 0.35);
  }

  .nav-link:hover,
  .nav-link:focus-visible,
  .mobile-nav-link:hover,
  .mobile-nav-link:focus-visible {
    color: var(--color-text-primary);
    outline: none;
  }

  :global(html.dark) .nav-link:hover,
  :global(html.dark) .nav-link:focus-visible,
  :global(html.dark) .mobile-nav-link:hover,
  :global(html.dark) .mobile-nav-link:focus-visible {
    text-shadow:
      0 0 10px rgba(56, 189, 248, 0.55),
      0 0 22px rgba(217, 70, 239, 0.35),
      0 0 36px rgba(96, 165, 250, 0.2);
  }

  :global(html.light) .nav-link:hover,
  :global(html.light) .nav-link:focus-visible,
  :global(html.light) .mobile-nav-link:hover,
  :global(html.light) .mobile-nav-link:focus-visible {
    text-shadow:
      0 0 8px rgba(14, 165, 233, 0.35),
      0 0 18px rgba(192, 38, 211, 0.22);
  }

  .nav-link:hover::after,
  .nav-link:focus-visible::after,
  .mobile-nav-link:hover::after,
  .mobile-nav-link:focus-visible::after {
    transform: scaleX(1);
  }

  .nav-icon {
    align-items: center;
    justify-content: center;
    color: var(--color-text-secondary);
    background: transparent;
    border: 0;
    padding: 0.55rem;
    border-radius: 0.5rem;
    cursor: pointer;
    transition:
      color 0.28s ease,
      filter 0.35s ease,
      transform 0.28s ease,
      background-color 0.28s ease;
  }

  .nav-icon:hover,
  .nav-icon:focus-visible {
    color: var(--color-text-primary);
    outline: none;
    transform: translateY(-1px);
  }

  :global(html.dark) .nav-icon:hover,
  :global(html.dark) .nav-icon:focus-visible {
    filter:
      drop-shadow(0 0 6px rgba(56, 189, 248, 0.75))
      drop-shadow(0 0 14px rgba(217, 70, 239, 0.45));
  }

  :global(html.light) .nav-icon:hover,
  :global(html.light) .nav-icon:focus-visible {
    filter:
      drop-shadow(0 0 5px rgba(14, 165, 233, 0.45))
      drop-shadow(0 0 12px rgba(192, 38, 211, 0.28));
  }

  .nav-lang {
    color: var(--color-text-secondary);
    transition:
      color 0.28s ease,
      border-color 0.35s ease,
      box-shadow 0.35s ease,
      text-shadow 0.35s ease,
      transform 0.28s ease;
  }

  .nav-lang:hover,
  .nav-lang:focus-visible {
    color: var(--color-text-primary);
    outline: none;
    transform: translateY(-1px);
  }

  :global(html.dark) .nav-lang:hover,
  :global(html.dark) .nav-lang:focus-visible {
    border-color: rgba(56, 189, 248, 0.45);
    box-shadow:
      0 0 0 1px rgba(217, 70, 239, 0.2),
      0 0 16px rgba(56, 189, 248, 0.28),
      0 0 28px rgba(217, 70, 239, 0.18);
    text-shadow: 0 0 12px rgba(56, 189, 248, 0.45);
  }

  :global(html.light) .nav-lang:hover,
  :global(html.light) .nav-lang:focus-visible {
    border-color: rgba(14, 165, 233, 0.4);
    box-shadow:
      0 0 0 1px rgba(192, 38, 211, 0.15),
      0 0 14px rgba(14, 165, 233, 0.18),
      0 0 24px rgba(192, 38, 211, 0.12);
  }

  .nav-logo {
    transition:
      filter 0.4s ease,
      transform 0.3s ease;
  }

  .nav-logo:hover,
  .nav-logo:focus-visible {
    outline: none;
    transform: scale(1.04);
  }

  :global(html.dark) .nav-logo:hover,
  :global(html.dark) .nav-logo:focus-visible {
    filter:
      drop-shadow(0 0 8px rgba(56, 189, 248, 0.55))
      drop-shadow(0 0 18px rgba(217, 70, 239, 0.35));
  }

  :global(html.light) .nav-logo:hover,
  :global(html.light) .nav-logo:focus-visible {
    filter:
      drop-shadow(0 0 6px rgba(14, 165, 233, 0.35))
      drop-shadow(0 0 14px rgba(192, 38, 211, 0.22));
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-link,
    .mobile-nav-link,
    .nav-icon,
    .nav-lang,
    .nav-logo,
    .nav-link::after,
    .mobile-nav-link::after {
      transition: none;
    }

    .nav-icon:hover,
    .nav-lang:hover,
    .nav-logo:hover {
      transform: none;
    }
  }
</style>

<script>
  import { bootNavbar } from "@/scripts/navbar";
  bootNavbar();
</script>
