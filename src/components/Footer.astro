---
import type { Locale } from "@/i18n/utils";
import { t } from "@/i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i18n = t(locale);
const year = new Date().getFullYear();
---

<footer class="relative border-t border-glass-border py-8 pb-[max(2rem,env(safe-area-inset-bottom))]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center justify-between gap-4 sm:flex-row">
      <div class="flex items-center gap-2 text-sm text-text-secondary">
        <span>© {year} Alessio Brunello.</span>
        <span>{i18n.footer.rights}</span>
        <span aria-hidden="true">·</span>
        <a
          href={`/${locale}/privacy/`}
          class="underline-offset-4 transition-colors hover:text-accent hover:underline"
        >{i18n.footer.privacy}</a>
      </div>
      <p class="flex items-center gap-1.5 text-sm text-text-secondary">
        <span>Developed with</span>
        <svg class="h-3.5 w-3.5 text-accent" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
        </svg>
        <span class="font-medium text-text-primary">Love</span>
        <span>&amp;</span>
        <svg class="h-3.5 w-3.5 text-accent" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M11 2l1.2 5.4L17 9l-4.8 1.6L11 16l-1.2-5.4L5 9l4.8-1.6L11 2zm7.5 9l.7 3.1L22 15l-2.8.9-.7 3.1-.7-3.1L15 15l2.8-.9.7-3.1zM6.5 15l.6 2.5L9.5 18l-2.4.7-.6 2.5-.6-2.5L3.5 18l2.4-.5.6-2.5z"/>
        </svg>
        <span class="font-medium text-text-primary">Passion</span>
      </p>
      <!-- Social links -->
      <div class="flex items-center gap-4">
        <a href="https://www.linkedin.com/in/alessio-brunello-dev" target="_blank" rel="noopener noreferrer" class="text-text-secondary transition-colors hover:text-accent" aria-label="LinkedIn">
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>
        <a href="https://github.com/brunelloalessio-dev" target="_blank" rel="noopener noreferrer" class="text-text-secondary transition-colors hover:text-accent" aria-label="GitHub">
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
